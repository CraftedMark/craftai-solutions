# Function to display all info
show_info() {
    echo "🌐 CraftAI Website Configuration"
    echo "================================"
    echo "Environment: $WEBSITE_ENV"
    echo "Local Dev: http://localhost:$LOCAL_DEV_PORT"
    echo "Production: http://$PRODUCTION_SERVER:$PRODUCTION_PORT"
    echo "VPS: http://$VPS_SERVER:$VPS_PORT"
    echo ""
    echo "Live reload server status:"
    if lsof -i :8080 > /dev/null 2>&1; then
        echo "✅ Running on port 8080"
    else
        echo "❌ Not running - start with: ./run-live.sh"
    fi
}

# Execute if run directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
