---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'CraftAI Solutions — UniFi networks, AI workflow automation, and custom software for businesses that want to move faster.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'CraftAI Solutions',
  url: 'https://craftai.solutions',
  email: 'mark@craftai.solutions',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  knowsAbout: [
    'UniFi network design and deployment',
    'AI workflow automation',
    'Software development',
    'IT infrastructure management',
  ],
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CraftAI Solutions" />
  <meta property="og:title" content={`${title} — CraftAI Solutions`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${title} — CraftAI Solutions`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0f1a" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="CraftAI" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />

  <title>{title} — CraftAI Solutions</title>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
      // anime.js owns the entrance choreography. Flag it before first paint so
      // .reveal elements start hidden ONLY when JS can actually animate them
      // back in — no JS, or a failed bundle, leaves everything visible.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anime');
        // If the page module never runs, nothing would ever un-hide .reveal.
        // Drop the guard so content appears; the module clears this on start.
        window.__animeFailsafe = setTimeout(function() {
          document.documentElement.classList.remove('anime');
        }, 4000);
      }
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <slot />
  <script is:inline>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }
  </script>
</body>
</html>

<style is:global>
  /* ─── RESET ─── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* Palette — tinted neutrals toward slate-blue */
    --slate-950: #0a0f1a;
    --slate-900: #0f172a;
    --slate-800: #1e293b;
    --slate-700: #334155;
    --slate-600: #475569;
    --slate-500: #64748b;
    --slate-400: #94a3b8;
    --slate-300: #cbd5e1;
    --slate-200: #e2e8f0;
    --slate-100: #f1f5f9;
    --slate-50: #f8fafc;

    --blue-600: #2563eb;
    --blue-500: #3b82f6;
    --blue-400: #60a5fa;
    --amber-500: #f59e0b;
    --amber-400: #fbbf24;
    --amber-300: #fcd34d;

    /* Semantic tokens — light mode */
    --bg-primary: var(--slate-50);
    --bg-secondary: #ffffff;
    --bg-elevated: var(--slate-100);
    --bg-inverse: var(--slate-900);
    --text-primary: var(--slate-900);
    --text-secondary: var(--slate-600);
    --text-tertiary: var(--slate-400);
    --text-inverse: var(--slate-50);
    --accent: var(--blue-600);
    --accent-hover: var(--blue-500);
    --accent-warm: #b45309;
    --border: var(--slate-200);
    --border-subtle: var(--slate-100);

    /* Theme-aware surfaces & hairlines (over the WebGL background) */
    --line: rgba(15, 23, 42, 0.08);
    --line-strong: rgba(15, 23, 42, 0.16);
    --card-bg: rgba(255, 255, 255, 0.72);
    --input-bg: rgba(255, 255, 255, 0.6);
    --ghost-border: rgba(15, 23, 42, 0.18);
    --ghost-hover-bg: rgba(15, 23, 42, 0.05);

    /* Typography */
    --font-display: 'Space Grotesk', system-ui, sans-serif;
    --font-body: 'DM Sans', system-ui, sans-serif;

    /* Spacing scale */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2.5rem;
    --space-2xl: 4rem;
    --space-3xl: 6rem;
    --space-4xl: 10rem;

    /* Transitions */
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --duration-normal: 600ms;
    --duration-slow: 1000ms;
  }

  /* ─── DARK MODE ─── */
  .dark {
    --bg-primary: var(--slate-950);
    --bg-secondary: var(--slate-900);
    --bg-elevated: var(--slate-800);
    --bg-inverse: var(--slate-50);
    --text-primary: var(--slate-100);
    --text-secondary: var(--slate-400);
    --text-tertiary: var(--slate-500);
    --text-inverse: var(--slate-900);
    --accent: var(--blue-400);
    --accent-hover: var(--blue-500);
    --accent-warm: var(--amber-400);
    --border: var(--slate-800);
    --border-subtle: var(--slate-800);

    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.16);
    --card-bg: rgba(10, 15, 26, 0.55);
    --input-bg: rgba(255, 255, 255, 0.04);
    --ghost-border: rgba(255, 255, 255, 0.15);
    --ghost-hover-bg: rgba(255, 255, 255, 0.05);
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-body);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
    transition: background 0.3s ease, color 0.3s ease;
  }

  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }

  ::selection {
    background: var(--accent);
    color: #fff;
  }

  /* Visible keyboard focus everywhere */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ─── SKIP LINK ─── */
  .skip-link {
    position: fixed;
    top: -100%;
    left: var(--space-md);
    z-index: 200;
    padding: var(--space-sm) var(--space-md);
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 8px;
    transition: top 0.2s ease;
  }
  .skip-link:focus-visible { top: var(--space-md); }

  /* ─── UTILITIES ─── */
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }

  .container--wide {
    max-width: 1400px;
  }

  /* ─── REVEAL ANIMATIONS ─── */
  /* anime.js drives opacity/transform on these — no CSS transition, or the two
     would fight over the same properties. The .anime guard (set pre-paint in
     <head>) means no-JS and reduced-motion users get fully visible content. */
  html.anime .reveal { opacity: 0; }
  html.anime .reveal.visible { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
