---
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  {
    tag: 'Networks',
    title: 'UniFi Integrations',
    description: 'Enterprise-grade network design, deployment, and management. From access points to security cameras — a single pane of glass for your entire infrastructure.',
    capabilities: ['Network architecture & site surveys', 'Access point & switch deployment', 'Camera & security systems', 'VPN & remote access', 'Ongoing monitoring & support'],
  },
  {
    tag: 'Automation',
    title: 'AI Workflow Automation',
    description: 'Stop doing repetitive work. We build intelligent automations that connect your tools, process your data, and free your team to focus on what matters.',
    capabilities: ['Process analysis & optimization', 'Custom AI agent development', 'Tool & API integrations', 'Document processing & extraction', 'Predictive analytics & alerts'],
  },
  {
    tag: 'Development',
    title: 'Software & App Development',
    description: 'Custom applications, web platforms, and mobile apps built to fit your business — not the other way around. From MVPs to production systems.',
    capabilities: ['Web & mobile applications', 'API development & integrations', 'Database design & optimization', 'Cloud deployment & DevOps', 'Ongoing maintenance & iteration'],
  },
];

const also = [
  {
    title: 'IT Infrastructure Management',
    description: 'Servers, backups, security hardening, and monitoring — handled, so your team can focus on the business.',
  },
];

const steps = [
  { num: '01', title: 'Discovery', desc: 'We audit your current setup and understand your goals. No jargon, no upselling — just honest assessment.' },
  { num: '02', title: 'Design', desc: 'A clear plan with scope, timeline, and cost. You approve before any work begins.' },
  { num: '03', title: 'Deploy', desc: 'We build it, test it, and hand it over — with documentation and training so your team owns it.' },
  { num: '04', title: 'Support', desc: "Ongoing monitoring, maintenance, and a direct line when you need it. We don't disappear after go-live." },
];
---

<BaseLayout title="Home">
  <!-- ═══ NAV ═══ -->
  <nav class="nav" id="nav">
    <div class="container nav__inner">
      <a href="/" class="nav__logo" aria-label="CraftAI Solutions home">
        <svg class="nav__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="28" height="28" rx="6" stroke="currentColor" stroke-width="2.5"/>
          <path d="M10 16h4l2-5 2 10 2-5h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="nav__wordmark">CraftAI</span>
      </a>
      <div class="nav__links">
        <a href="#services" class="nav__link">Services</a>
        <a href="#process" class="nav__link">Process</a>
        <a href="#about" class="nav__link">About</a>
        <a href="#contact" class="nav__link">Contact</a>
        <button class="nav__theme" id="theme-toggle" aria-label="Toggle dark mode">
          <svg class="nav__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg class="nav__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
      <button class="nav__burger" id="nav-burger" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
    </div>
    <div class="nav__mobile" id="nav-mobile">
      <a href="#services">Services</a>
      <a href="#process">Process</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </div>
    <div class="nav__progress" id="nav-progress" aria-hidden="true"></div>
  </nav>

  <!-- ═══ FULL-PAGE WEBGL BACKGROUND ═══ -->
  <canvas id="gl-canvas" class="gl-bg"></canvas>

  <main id="main">
    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__content" id="hero-content">
          <div class="hero__eyebrow reveal" data-hero>Smart Infrastructure for Modern Business</div>
          <h1 class="hero__title" id="hero-title">
            Infrastructure<br/>that <em><span id="hero-word">thinks</span><span class="hero__word-cursor">.</span></em>
          </h1>
          <p class="hero__sub reveal" data-hero>
            We design networks, build automations, and ship software — so your business runs smoother, faster, and smarter, without adding headcount.
          </p>
          <div class="hero__actions reveal" data-hero>
            <a href="#contact" class="btn btn--primary">Start a conversation</a>
            <a href="#services" class="btn btn--ghost">See how we work</a>
          </div>
        </div>
      </div>
      <div class="hero__scroll reveal" data-hero aria-hidden="true"><span class="hero__scroll-line"></span></div>
    </section>

    <!-- ═══ PINNED CHAPTER (scroll-scrubbed) ═══ -->
    <section class="chapter" id="chapter" aria-label="What we do, in two words">
      <div class="chapter__sticky">
        <img class="chapter__bg" id="chapter-bg" src="/chapter-bg.jpg" alt="" aria-hidden="true" onerror="this.style.display='none'" />
        <div class="chapter__word chapter__word--1" id="chapter-word-1">Networks.</div>
        <div class="chapter__word chapter__word--2" id="chapter-word-2">Automations.</div>
        <div class="chapter__word chapter__word--3" id="chapter-word-3">Software.</div>
        <div class="chapter__hint" id="chapter-hint">Three disciplines. One team.</div>
      </div>
    </section>

    <!-- ═══ SERVICES ═══ -->
    <section class="services" id="services">
      <div class="container">
        <div class="services__header reveal">
          <span class="tag">What We Do</span>
          <h2 class="heading"><span class="hline"><span>Three disciplines.</span></span><span class="hline"><span>One team.</span></span></h2>
        </div>
        <div class="services__grid">
          {pillars.map((s) => (
            <div class="svc reveal">
              <span class="svc__tag">{s.tag}</span>
              <h3 class="svc__title">{s.title}</h3>
              <p class="svc__desc">{s.description}</p>
              <ul class="svc__list">
                {s.capabilities.map(c => (
                  <li>
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="also reveal">
          <span class="also__label">Also part of the work</span>
          <div class="also__grid">
            {also.map(a => (
              <div class="also__item">
                <h3 class="also__title">{a.title}</h3>
                <p class="also__desc">{a.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ STATS ═══ -->
    <section class="stats">
      <div class="container stats__inner reveal">
        <div class="stat"><span class="stat__num" data-count="500">0</span><span class="stat__suf">+</span><span class="stat__label">Devices deployed</span></div>
        <div class="stat__div" aria-hidden="true"></div>
        <div class="stat"><span class="stat__num" data-count="50">0</span><span class="stat__suf">+</span><span class="stat__label">Businesses served</span></div>
        <div class="stat__div" aria-hidden="true"></div>
        <div class="stat"><span class="stat__num" data-count="100">0</span><span class="stat__suf">%</span><span class="stat__label">Client retention</span></div>
      </div>
    </section>

    <!-- ═══ PROCESS ═══ -->
    <section class="process" id="process">
      <div class="container">
        <div class="process__header reveal">
          <span class="tag">How It Works</span>
          <h2 class="heading"><span class="hline"><span>Clear process.</span></span><span class="hline"><span>No surprises.</span></span></h2>
        </div>
        <div class="process__grid">
          {steps.map((s) => (
            <div class="step reveal">
              <span class="step__num">{s.num}</span>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ ABOUT ═══ -->
    <section class="about" id="about">
      <div class="container about__inner">
        <div class="about__content reveal">
          <span class="tag">Who You'll Work With</span>
          <h2 class="heading"><span class="hline"><span>The person you talk to</span></span><span class="hline"><span>is the person who builds it.</span></span></h2>
          <p class="about__text">
            CraftAI Solutions is led by Mark — no account managers, no handoffs to a
            junior team, no layers between you and the work. You get a direct line to
            the engineer who designs your network and writes your automations.
          </p>
          <p class="about__text">
            Based in Los Angeles, working with businesses that want enterprise-grade
            infrastructure without enterprise-grade overhead.
          </p>
        </div>
        <div class="about__card reveal">
          <div class="about__avatar" aria-hidden="true">M</div>
          <h3 class="about__name">Mark</h3>
          <p class="about__role">Founder & Lead Engineer</p>
          <ul class="about__facts">
            <li>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Direct line — no ticket queue
            </li>
            <li>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Documentation & training included
            </li>
            <li>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Replies within one business day
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="cta" id="contact">
      <div class="container cta__inner">
        <div class="cta__content reveal">
          <span class="tag">Let's Talk</span>
          <h2 class="cta__title"><span class="hline"><span>Ready to stop</span></span><span class="hline"><span>duct-taping it together?</span></span></h2>
          <p class="cta__sub">Tell us what you're working with. We'll tell you what's possible — no pitch deck, no pressure.</p>

          <form
            id="contact-form"
            class="contact-form"
            action="https://formspree.io/f/mark@craftai.solutions"
            method="POST"
          >
            <input type="text" name="_gotcha" class="cf-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="cf-row">
              <div class="cf-field">
                <label for="cf-name" class="cf-label">Name</label>
                <input id="cf-name" name="name" type="text" class="cf-input" placeholder="Your name" required />
              </div>
              <div class="cf-field">
                <label for="cf-email" class="cf-label">Email</label>
                <input id="cf-email" name="email" type="email" class="cf-input" placeholder="you@company.com" required />
              </div>
            </div>
            <div class="cf-field">
              <label for="cf-msg" class="cf-label">What are you working with?</label>
              <textarea id="cf-msg" name="message" class="cf-input cf-textarea" rows="4" placeholder="Tell us about your setup, what's broken, or what you want to build." required></textarea>
            </div>
            <div class="cf-footer">
              <button type="submit" class="btn btn--primary btn--lg cf-submit" id="cf-submit">
                <span class="cf-submit-text">Send message</span>
                <span class="cf-submit-spinner" aria-hidden="true"></span>
              </button>
              <p class="cf-privacy">We don't share your info. Ever.</p>
            </div>
            <div class="cf-success" id="cf-success" aria-live="polite" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
              <div>
                <strong>Message sent.</strong>
                <p>We'll be in touch within one business day.</p>
              </div>
            </div>
            <div class="cf-error" id="cf-error" aria-live="polite" hidden>
              Something went wrong. Email us directly at <a href="mailto:mark@craftai.solutions">mark@craftai.solutions</a>.
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__brand">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="2" y="2" width="28" height="28" rx="6" stroke="currentColor" stroke-width="2.5"/><path d="M10 16h4l2-5 2 10 2-5h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>CraftAI Solutions</span>
      </div>
      <a class="footer__mail" href="mailto:mark@craftai.solutions">mark@craftai.solutions</a>
      <p class="footer__copy">&copy; {new Date().getFullYear()} CraftAI Solutions. Los Angeles, CA.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ── NAV ── */
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: var(--space-md) 0; transition: background .3s, backdrop-filter .3s; }
  .nav.scrolled { background: color-mix(in srgb, var(--bg-primary) 85%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-subtle); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; }
  .nav__logo { display: flex; align-items: center; gap: var(--space-sm); font-family: var(--font-display); font-weight: 600; font-size: 1.125rem; letter-spacing: -.02em; }
  .nav__mark { width: 28px; height: 28px; }
  .nav__links { display: flex; align-items: center; gap: var(--space-xl); }
  .nav__link { font-family: var(--font-display); font-size: .875rem; font-weight: 500; color: var(--text-secondary); letter-spacing: .02em; transition: color .2s; }
  .nav__link:hover { color: var(--text-primary); }
  .nav__theme { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--border); border-radius: 8px; background: transparent; cursor: pointer; color: var(--text-secondary); transition: color .2s, border-color .2s; }
  .nav__theme:hover { color: var(--text-primary); border-color: var(--text-tertiary); }
  .nav__sun, .nav__moon { width: 18px; height: 18px; }
  .nav__moon { display: none; }
  :global(.dark) .nav__sun { display: none; }
  :global(.dark) .nav__moon { display: block; }
  .nav__burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav__burger span { width: 22px; height: 2px; background: var(--text-primary); transition: transform .3s, opacity .3s; }
  .nav__burger[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav__burger[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .nav__mobile { display: none; flex-direction: column; padding: var(--space-lg) clamp(1.25rem,4vw,2.5rem); gap: var(--space-md); background: color-mix(in srgb, var(--bg-primary) 92%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-subtle); }
  .nav__mobile.open { display: flex; }
  .nav__mobile a { font-family: var(--font-display); font-size: 1.125rem; font-weight: 500; color: var(--text-secondary); padding: var(--space-sm) 0; border-bottom: 1px solid var(--border-subtle); }
  .nav__progress { position: absolute; bottom: -1px; left: 0; height: 2px; width: 0%; background: var(--accent); transition: width .1s linear; }
  @media (max-width: 768px) { .nav__links { display: none; } .nav__burger { display: flex; } }

  /* ── FULL-PAGE GL BACKGROUND ── */
  .gl-bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }

  /* ── HERO ── */
  .hero { position: relative; min-height: 100vh; display: flex; align-items: center; padding: var(--space-4xl) 0 var(--space-3xl); overflow: hidden; background: transparent; z-index: 1; }
  .hero__inner { position: relative; z-index: 1; max-width: 680px; }
  .hero__content { will-change: transform, opacity; }
  .hero__eyebrow { font-family: var(--font-display); font-size: clamp(.75rem,1vw,.875rem); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: var(--space-lg); }
  .hero__title { font-family: var(--font-display); font-size: clamp(3rem,7vw,5.5rem); font-weight: 700; line-height: 1.02; letter-spacing: -.04em; margin-bottom: var(--space-xl); color: var(--text-primary); }
  .hero__title em { font-style: italic; color: var(--accent); }
  .hero__sub { font-size: clamp(1rem,1.5vw,1.25rem); color: var(--text-secondary); max-width: 520px; line-height: 1.65; margin-bottom: var(--space-xl); }
  .hero__actions { display: flex; gap: var(--space-md); flex-wrap: wrap; }
  .hero__scroll { position: absolute; bottom: var(--space-xl); left: 50%; transform: translateX(-50%); }
  .hero__scroll-line { display: block; width: 1px; height: 48px; background: linear-gradient(to bottom, var(--text-tertiary), transparent); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity: .3; transform: scaleY(.6); } 50% { opacity: 1; transform: scaleY(1); } }
  @media (max-width: 960px) { .hero { min-height: 90vh; } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line { animation: none; } }

  /* Char-split entrance — JS wraps each char in .chr inside a .chm overflow mask,
     then anime.js animates translateY. The 115% start state lives in CSS so chars
     are masked the instant they exist (no flash of unmasked text). Static text is
     the no-JS / reduced-motion fallback.

     :global() is required — these spans are created at runtime, so they never
     carry Astro's data-astro-cid attribute and scoped selectors would not match
     them (which silently left .chr as display:inline, where transforms are a
     no-op, and .chm unmasked). */
  :global(.chm) { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: .08em; margin-bottom: -.08em; }
  :global(.chr) { display: inline-block; transform: translateY(115%); will-change: transform; }
  @media (prefers-reduced-motion: reduce) { :global(.chr) { transform: none; } }

  /* ── PINNED CHAPTER ── */
  .chapter { position: relative; z-index: 1; height: 320vh; }
  .chapter__sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .chapter__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; filter: brightness(.75) saturate(1.1); will-change: opacity; }
  :global(html:not(.dark)) .chapter__bg { display: none; }
  .chapter__word {
    position: absolute;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 11vw, 9.5rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1;
    color: var(--text-primary);
    opacity: 0;
    will-change: transform, opacity;
    text-align: center;
    padding: 0 var(--space-lg);
  }
  .chapter__word--2 { color: var(--accent); font-style: italic; }
  .chapter__word--3 { color: var(--accent-warm); }
  .chapter__hint {
    position: absolute;
    bottom: 12vh;
    font-family: var(--font-display);
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    opacity: 0;
    will-change: opacity;
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter { height: auto; }
    .chapter__sticky { position: relative; height: auto; padding: var(--space-4xl) 0; flex-direction: column; gap: var(--space-lg); }
    .chapter__word { position: relative; opacity: 1; }
    .chapter__hint { position: relative; bottom: auto; opacity: 1; }
    .chapter__bg { display: none; }
  }

  /* ── BUTTONS ── */
  .btn { display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: .9375rem; font-weight: 600; padding: .75rem 1.75rem; border-radius: 8px; border: none; cursor: pointer; transition: all .2s; letter-spacing: -.01em; text-decoration: none; }
  .btn--primary { background: var(--accent); color: #fff; }
  .btn--primary:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 30%, transparent); }
  .btn--ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--ghost-border); }
  .btn--ghost:hover { color: var(--text-primary); border-color: var(--text-tertiary); background: var(--ghost-hover-bg); }
  .btn--lg { padding: 1rem 2rem; font-size: 1rem; }

  /* ── SECTION COMMON ── */
  .tag { font-family: var(--font-display); font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: var(--space-md); }
  .heading { font-family: var(--font-display); font-size: clamp(2rem,4vw,3.25rem); font-weight: 700; line-height: 1.1; letter-spacing: -.03em; color: var(--text-primary); }

  /* Masked line reveals for section headings */
  .hline { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .hline > span { display: block; transform: translateY(115%); transition: transform 900ms var(--ease-out-expo); }
  .visible .hline > span { transform: translateY(0); }
  .visible .hline:nth-child(2) > span { transition-delay: 120ms; }
  @media (prefers-reduced-motion: reduce) {
    .hline > span { transform: none; transition: none; }
  }

  /* ── SERVICES ── */
  .services { position: relative; z-index: 1; padding: var(--space-4xl) 0; background: transparent; }
  .services__header { margin-bottom: var(--space-3xl); max-width: 500px; }
  .services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  .svc { padding: var(--space-xl); border: 1px solid var(--line); border-radius: 12px; transition: border-color .3s, box-shadow .3s; background: var(--card-bg); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .svc:hover { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .svc__tag { font-family: var(--font-display); font-size: .6875rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-warm); display: block; margin-bottom: var(--space-lg); }
  .svc__title { font-family: var(--font-display); font-size: clamp(1.35rem, 2vw, 1.625rem); font-weight: 700; letter-spacing: -.02em; margin-bottom: var(--space-md); color: var(--text-primary); }
  .svc__desc { color: var(--text-secondary); line-height: 1.65; margin-bottom: var(--space-xl); }
  .svc__list { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
  .svc__list li { display: flex; align-items: center; gap: var(--space-sm); font-size: .9375rem; color: var(--text-secondary); }
  .svc__list svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--accent); }
  @media (max-width: 960px) { .services__grid { grid-template-columns: 1fr; } }

  /* ── ALSO ── */
  .also { margin-top: var(--space-lg); padding: var(--space-xl) var(--space-2xl); border: 1px dashed var(--line-strong); border-radius: 12px; }
  .also__label { font-family: var(--font-display); font-size: .6875rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--text-tertiary); display: block; margin-bottom: var(--space-lg); }
  .also__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }
  .also__title { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; letter-spacing: -.01em; margin-bottom: var(--space-xs); color: var(--text-primary); }
  .also__desc { font-size: .9375rem; color: var(--text-secondary); line-height: 1.6; }
  @media (max-width: 768px) { .also__grid { grid-template-columns: 1fr; } .also { padding: var(--space-xl); } }

  /* ── STATS ── */
  .stats { position: relative; z-index: 1; padding: var(--space-3xl) 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: transparent; }
  .stats__inner { display: flex; justify-content: center; align-items: center; gap: var(--space-3xl); }
  .stat { text-align: center; }
  .stat__num { font-family: var(--font-display); font-size: clamp(2.5rem,5vw,3.5rem); font-weight: 700; letter-spacing: -.03em; line-height: 1; color: var(--text-primary); }
  .stat__suf { font-family: var(--font-display); font-size: clamp(1.5rem,3vw,2rem); font-weight: 700; color: var(--accent); }
  .stat__label { display: block; font-size: .875rem; color: var(--text-secondary); margin-top: var(--space-xs); }
  .stat__div { width: 1px; height: 48px; background: var(--line-strong); }
  @media (max-width: 640px) { .stats__inner { gap: var(--space-xl); } .stat__div { height: 32px; } }

  /* ── PROCESS ── */
  .process { position: relative; z-index: 1; padding: var(--space-4xl) 0; background: transparent; }
  .process__header { margin-bottom: var(--space-3xl); max-width: 500px; }
  .process__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: var(--space-lg); }
  .step { position: relative; padding-top: var(--space-xl); }
  .step::before,
  .step::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
  .step::before { background: var(--line); }
  .step::after {
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 900ms var(--ease-out-expo);
  }
  .step.visible::after { transform: scaleX(1); }
  .step:nth-child(1)::after { transition-delay: 150ms; }
  .step:nth-child(2)::after { transition-delay: 300ms; }
  .step:nth-child(3)::after { transition-delay: 450ms; }
  .step:nth-child(4)::after { transition-delay: 600ms; }
  .step__num { font-family: var(--font-display); font-size: .75rem; font-weight: 600; letter-spacing: .08em; color: var(--accent); display: block; margin-bottom: var(--space-md); }
  .step__title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; letter-spacing: -.01em; margin-bottom: var(--space-sm); color: var(--text-primary); }
  .step__desc { font-size: .9375rem; color: var(--text-secondary); line-height: 1.6; }
  @media (max-width: 768px) {
    .process__grid { grid-template-columns: 1fr; gap: 0; }
    .step { padding: var(--space-xl) 0 var(--space-xl) var(--space-xl); }
    .step::before,
    .step::after { top: 0; bottom: 0; left: 0; right: auto; width: 2px; height: auto; }
    .step::after { transform: scaleY(0); transform-origin: top; }
    .step.visible::after { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .step::after { transition: none; transform: scaleX(1); }
  }

  /* ── ABOUT ── */
  .about { position: relative; z-index: 1; padding: var(--space-4xl) 0; border-top: 1px solid var(--line); background: transparent; }
  .about__inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-3xl); align-items: center; }
  .about__text { font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.7; margin-top: var(--space-lg); max-width: 520px; }
  .about__card { padding: var(--space-2xl); border: 1px solid var(--line); border-radius: 12px; background: var(--card-bg); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .about__avatar { width: 64px; height: 64px; border-radius: 16px; background: linear-gradient(135deg, var(--accent), var(--accent-warm)); color: #fff; font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-lg); }
  .about__name { font-family: var(--font-display); font-size: 1.375rem; font-weight: 700; letter-spacing: -.02em; color: var(--text-primary); }
  .about__role { font-size: .875rem; color: var(--text-tertiary); margin-bottom: var(--space-xl); }
  .about__facts { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); }
  .about__facts li { display: flex; align-items: center; gap: var(--space-sm); font-size: .9375rem; color: var(--text-secondary); }
  .about__facts svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--accent); }
  @media (max-width: 900px) { .about__inner { grid-template-columns: 1fr; gap: var(--space-2xl); } .about__card { max-width: 420px; } }

  /* ── CTA ── */
  .cta { position: relative; z-index: 1; padding: var(--space-4xl) 0; background: transparent; border-top: 1px solid var(--line); }
  .cta__inner { max-width: 640px; }
  .cta__title { font-family: var(--font-display); font-size: clamp(2rem,4vw,3rem); font-weight: 700; line-height: 1.1; letter-spacing: -.03em; margin-bottom: var(--space-lg); color: var(--text-primary); }
  .cta__sub { font-size: 1.125rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: var(--space-2xl); }

  /* ── HERO WORD SWAP (blur-flip) — driven by an anime.js loop timeline ── */
  #hero-word { display: inline-block; }
  .hero__word-cursor {
    display: inline-block;
    color: var(--accent);
  }

  /* ── CONTACT FORM ── */
  .contact-form { display: flex; flex-direction: column; gap: var(--space-lg); margin-top: var(--space-xl); }
  .cf-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  @media (max-width: 640px) { .cf-row { grid-template-columns: 1fr; } }
  .cf-field { display: flex; flex-direction: column; gap: 6px; }
  .cf-label { font-family: var(--font-display); font-size: .8125rem; font-weight: 600; letter-spacing: .04em; color: var(--text-secondary); text-transform: uppercase; }
  .cf-input {
    background: var(--input-bg);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    padding: .75rem 1rem;
    font-family: var(--font-body);
    font-size: .9375rem;
    color: var(--text-primary);
    transition: border-color .2s, background .2s, box-shadow .2s;
    outline: none;
    width: 100%;
  }
  .cf-input::placeholder { color: var(--text-tertiary); }
  .cf-input:hover { border-color: var(--text-tertiary); }
  .cf-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
  .cf-textarea { resize: vertical; min-height: 120px; }
  .cf-footer { display: flex; align-items: center; gap: var(--space-lg); flex-wrap: wrap; }
  .cf-privacy { font-size: .8125rem; color: var(--text-tertiary); }
  .cf-submit { position: relative; min-width: 160px; }
  .cf-submit.loading .cf-submit-text { opacity: 0; }
  .cf-submit.loading .cf-submit-spinner { opacity: 1; }
  .cf-submit-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity .2s;
  }
  .cf-submit-spinner::after {
    content: '';
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin .6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .cf-success, .cf-error { display: flex; align-items: flex-start; gap: var(--space-md); padding: var(--space-lg); border-radius: 10px; }
  .cf-success { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.25); color: #15803d; }
  :global(.dark) .cf-success { color: #86efac; }
  .cf-success svg { width: 22px; height: 22px; flex-shrink: 0; margin-top: 1px; }
  .cf-success strong { display: block; margin-bottom: 2px; font-family: var(--font-display); }
  .cf-success p { font-size: .9375rem; opacity: .8; }
  .cf-error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: #b91c1c; font-size: .9375rem; }
  :global(.dark) .cf-error { color: #fca5a5; }
  .cf-error a { text-decoration: underline; color: inherit; }
  [hidden] { display: none !important; }

  /* ── FOOTER ── */
  .footer { position: relative; z-index: 1; padding: var(--space-2xl) 0; border-top: 1px solid var(--line); background: transparent; }
  .footer__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); }
  .footer__brand { display: flex; align-items: center; gap: var(--space-sm); font-family: var(--font-display); font-weight: 600; font-size: .9375rem; color: var(--text-secondary); }
  .footer__brand svg { width: 24px; height: 24px; }
  .footer__mail { font-size: .8125rem; color: var(--text-secondary); transition: color .2s; }
  .footer__mail:hover { color: var(--accent); }
  .footer__copy { font-size: .8125rem; color: var(--text-tertiary); }
  @media (max-width: 640px) { .footer__inner { flex-direction: column; gap: var(--space-md); text-align: center; } }
</style>

<script>
  import * as THREE from 'three';
  import { animate, createTimeline, stagger, utils } from 'animejs';

  // The <head> script hid every .reveal behind html.anime and armed a failsafe in
  // case this module never runs (bundle 404, parse error). We're running — disarm it.
  clearTimeout((window as any).__animeFailsafe);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.matchMedia('(max-width: 768px)').matches;
  const isTouch = window.matchMedia('(hover: none)').matches;

  // ─── THEME ───
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // ─── SECTION ANCHORS (drive the WebGL scroll story) ───
  let anchors: number[] = [0, 0, 0, 0];
  let chapterTop = 0;
  let chapterRange = 1;
  function measure() {
    const q = (sel: string) => {
      const el = document.querySelector(sel);
      return el ? el.getBoundingClientRect().top + window.scrollY : 0;
    };
    anchors = [q('#services'), q('#process'), q('#about'), q('#contact')];
    const ch = document.getElementById('chapter');
    if (ch) {
      chapterTop = ch.getBoundingClientRect().top + window.scrollY;
      chapterRange = Math.max(1, ch.offsetHeight - window.innerHeight);
    }
  }
  measure();
  window.addEventListener('resize', measure);
  // Re-measure after fonts/assets settle so offsets are accurate
  window.addEventListener('load', measure);

  // ─── UNIFIED SCROLL HANDLER (nav, progress, hero parallax, chapter scrub, GL stage) ───
  const nav = document.getElementById('nav');
  const progressBar = document.getElementById('nav-progress');
  const heroContent = document.getElementById('hero-content');
  const chapterBg = document.getElementById('chapter-bg') as HTMLImageElement | null;
  const chapterWord1 = document.getElementById('chapter-word-1');
  const chapterWord2 = document.getElementById('chapter-word-2');
  const chapterWord3 = document.getElementById('chapter-word-3');
  const chapterHint = document.getElementById('chapter-hint');

  // Stage float: 0 = topology, 1 = two clusters, 2 = pipeline, 3 = single hub, 4 = constellation
  let stageTarget = 0;
  let scrollTicking = false;

  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
  const easeOutExpo = (t: number) => (t >= 1 ? 1 : 1 - Math.pow(2, -10 * t));
  const seg = (y: number, a: number, b: number) => Math.max(0, Math.min(1, (y - a) / Math.max(1, b - a)));
  const seg01 = (t: number, a: number, b: number) => Math.max(0, Math.min(1, (t - a) / (b - a)));

  function computeStage() {
    // Chapter scrubs stage 0→1 (topology → two clusters) 1:1 with scroll.
    // Later stages morph in as their sections approach: process→pipeline,
    // about→single hub, contact→constellation.
    const y = window.scrollY;
    const vh = window.innerHeight;
    const chapterP = seg(y, chapterTop, chapterTop + chapterRange);
    stageTarget =
      easeInOut(chapterP) +
      easeInOut(seg(y, anchors[1] - 0.9 * vh, anchors[1] - 0.45 * vh)) +
      easeInOut(seg(y, anchors[2] - 0.9 * vh, anchors[2] - 0.45 * vh)) +
      easeInOut(seg(y, anchors[3] - 0.9 * vh, anchors[3] - 0.45 * vh));

    // ── Chapter content scrub (words + backdrop art) ──
    if (!reducedMotion && chapterWord1 && chapterWord2 && chapterWord3) {
      const p = chapterP;
      const w1In = seg01(p, 0.04, 0.14);
      const w1Out = seg01(p, 0.24, 0.34);
      const w2In = seg01(p, 0.38, 0.48);
      const w2Out = seg01(p, 0.56, 0.66);
      const w3In = seg01(p, 0.7, 0.8);
      const w3Out = seg01(p, 0.93, 1);

      chapterWord1.style.opacity = String(w1In * (1 - w1Out));
      chapterWord1.style.transform = `translateY(${(1 - easeOutExpo(w1In)) * 60 - w1Out * 60}px) scale(${0.92 + easeOutExpo(w1In) * 0.08 + w1Out * 0.06})`;

      chapterWord2.style.opacity = String(w2In * (1 - w2Out));
      chapterWord2.style.transform = `translateY(${(1 - easeOutExpo(w2In)) * 60 - w2Out * 40}px) scale(${0.92 + easeOutExpo(w2In) * 0.08 + w2Out * 0.04})`;

      chapterWord3.style.opacity = String(w3In * (1 - w3Out));
      chapterWord3.style.transform = `translateY(${(1 - easeOutExpo(w3In)) * 60 - w3Out * 40}px) scale(${0.92 + easeOutExpo(w3In) * 0.08 + w3Out * 0.04})`;

      if (chapterHint) chapterHint.style.opacity = String(seg01(p, 0.84, 0.92) * (1 - seg01(p, 0.97, 1)));
      if (chapterBg) chapterBg.style.opacity = String(seg01(p, 0, 0.15) * (1 - seg01(p, 0.85, 1)) * 0.5);
    }
  }

  function onScroll() {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(() => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const p = docHeight > 0 ? Math.max(0, Math.min(1, scrollTop / docHeight)) : 0;

      nav?.classList.toggle('scrolled', scrollTop > 40);
      if (progressBar) progressBar.style.width = `${p * 100}%`;

      // Hero parallax — drifts up and fades as you scroll away
      if (heroContent && !reducedMotion) {
        const fade = Math.max(0, 1 - scrollTop / (window.innerHeight * 0.85));
        heroContent.style.transform = `translateY(${scrollTop * 0.18}px)`;
        heroContent.style.opacity = String(fade);
      }

      computeStage();
      scrollTicking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ─── MOBILE MENU ───
  const burger = document.getElementById('nav-burger');
  const mobile = document.getElementById('nav-mobile');

  function closeMobileMenu() {
    burger?.setAttribute('aria-expanded', 'false');
    mobile?.classList.remove('open');
  }

  burger?.addEventListener('click', () => {
    const exp = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!exp));
    mobile?.classList.toggle('open');
  });
  mobile?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMobileMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobile?.classList.contains('open')) {
      closeMobileMenu();
      burger?.focus();
    }
  });

  // ─── HERO TITLE CHAR SPLIT ───
  // Hand-rolled rather than anime.js splitText() because it must split ONLY the
  // plain text nodes ("Infrastructure", "that ") and leave the <em> word-swap
  // span untouched. Returns the .chr elements for the entrance timeline.
  function splitHeroTitle(title: HTMLElement): HTMLElement[] {
    const chars: HTMLElement[] = [];
    const splitNode = (node: ChildNode) => {
      if (node.nodeType !== Node.TEXT_NODE || !node.textContent) return;
      const frag = document.createDocumentFragment();
      for (const ch of node.textContent) {
        // All whitespace passes through untouched — wrapping the source
        // newlines/indentation produced empty animated spans.
        if (/\s/.test(ch)) { frag.appendChild(document.createTextNode(ch)); continue; }
        const mask = document.createElement('span');
        mask.className = 'chm';
        const inner = document.createElement('span');
        inner.className = 'chr';
        inner.textContent = ch;
        mask.appendChild(inner);
        frag.appendChild(mask);
        chars.push(inner);
      }
      node.replaceWith(frag);
    };
    Array.from(title.childNodes).forEach(splitNode);
    return chars;
  }

  // ─── HERO ENTRANCE (one anime.js timeline: title chars → eyebrow/sub/actions/cue) ───
  const heroTitle = document.getElementById('hero-title');
  const heroEls = Array.from(document.querySelectorAll<HTMLElement>('[data-hero]'));

  if (reducedMotion) {
    heroEls.forEach(el => el.classList.add('visible'));
  } else {
    const heroChars = heroTitle ? splitHeroTitle(heroTitle) : [];
    const heroTl = createTimeline({ defaults: { ease: 'outExpo' } });
    if (heroChars.length) {
      heroTl.add(heroChars, {
        translateY: ['115%', '0%'],
        duration: 900,
        delay: stagger(26),
      }, 200);
    }
    heroTl.add(heroEls, {
      opacity: [0, 1],
      translateY: [24, 0],
      duration: 800,
      delay: stagger(90),
      onBegin: () => heroEls.forEach(el => el.classList.add('visible')),
    }, 340);
  }

  // ─── SCROLL REVEALS ───
  // IntersectionObserver still owns the one-shot trigger; anime.js owns the motion
  // so sibling groups (card grids) cascade with a real stagger instead of the old
  // fixed reveal-delay-N CSS steps.
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal:not([data-hero])'));

  if (reducedMotion) {
    revealEls.forEach(el => el.classList.add('visible'));
  } else {
    // A parent's reveals stagger together only when EVERY element child is a
    // .reveal — that's true for the service/step grids and the about pair, but
    // not for a section .container holding a header and a distant block.
    const byParent = new Map<Element, HTMLElement[]>();
    revealEls.forEach(el => {
      const parent = el.parentElement;
      if (!parent) return;
      const siblings = byParent.get(parent);
      if (siblings) siblings.push(el); else byParent.set(parent, [el]);
    });

    const groupOf = new Map<HTMLElement, HTMLElement[]>();
    byParent.forEach((group, parent) => {
      const cohesive = group.length === parent.children.length;
      group.forEach(el => groupOf.set(el, cohesive ? group : [el]));
    });

    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const group = groupOf.get(e.target as HTMLElement) ?? [e.target as HTMLElement];
        group.forEach(el => {
          obs.unobserve(el);
          el.classList.add('visible');
        });
        animate(group, {
          opacity: [0, 1],
          translateY: [24, 0],
          duration: 850,
          ease: 'outExpo',
          delay: stagger(110),
        });
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(el => obs.observe(el));
  }

  // ─── STAT COUNTERS ───
  const statObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      statObs.unobserve(el);
      const target = parseInt(el.dataset.count || '0', 10);
      if (reducedMotion) { el.textContent = String(target); return; }
      animate(el, {
        innerHTML: [0, target],
        duration: 1600,
        ease: 'outQuart',
        modifier: utils.round(0),
      });
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(el => statObs.observe(el));

  // ─── THREE.JS SCROLL STORY: TOPOLOGY → 2 CLUSTERS → PIPELINE → SINGLE HUB → CONSTELLATION ───
  const canvas = document.getElementById('gl-canvas') as HTMLCanvasElement;
  if (canvas && !reducedMotion) {
    try {
      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: !isMobile, powerPreference: 'low-power' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 300);
      camera.position.set(0, 0, 30); // dolly-in start

      function resize() {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
      resize();
      window.addEventListener('resize', resize);

      // ═══════════════════════════════════════════════════════════
      // GLOW TEXTURES (fake bloom via additive radial sprites)
      // ═══════════════════════════════════════════════════════════
      function makeGlowTexture(r: number, g: number, b: number): THREE.CanvasTexture {
        const size = 128;
        const c = document.createElement('canvas');
        c.width = c.height = size;
        const ctx = c.getContext('2d')!;
        const grad = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        grad.addColorStop(0, 'rgba(255,255,255,0.95)');
        grad.addColorStop(0.18, `rgba(${r},${g},${b},0.85)`);
        grad.addColorStop(0.45, `rgba(${r},${g},${b},0.22)`);
        grad.addColorStop(1, `rgba(${r},${g},${b},0)`);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, size, size);
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        return tex;
      }

      const blueGlow = makeGlowTexture(96, 165, 250);   // blue-400
      const amberGlow = makeGlowTexture(251, 191, 36);  // amber-400

      // ═══════════════════════════════════════════════════════════
      // LAYER 1: ATMOSPHERIC STARFIELD (far background, z: -40 to -80)
      // ═══════════════════════════════════════════════════════════
      const starCount = isMobile ? 700 : 2000;
      const starPositions = new Float32Array(starCount * 3);
      const starSizes = new Float32Array(starCount);

      for (let i = 0; i < starCount; i++) {
        starPositions[i * 3] = (Math.random() - 0.5) * 200;
        starPositions[i * 3 + 1] = (Math.random() - 0.5) * 120;
        starPositions[i * 3 + 2] = -40 - Math.random() * 60;
        starSizes[i] = 0.3 + Math.random() * 1.5;
      }

      const starGeo = new THREE.BufferGeometry();
      starGeo.setAttribute('position', new THREE.Float32BufferAttribute(starPositions, 3));
      starGeo.setAttribute('size', new THREE.Float32BufferAttribute(starSizes, 1));

      const starMat = new THREE.ShaderMaterial({
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        uniforms: {
          uColor: { value: new THREE.Color(0x4a90d9) },
          uTime: { value: 0 },
        },
        vertexShader: `
          attribute float size;
          varying float vAlpha;
          uniform float uTime;
          void main() {
            vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
            gl_PointSize = size * (60.0 / -mvPos.z);
            gl_Position = projectionMatrix * mvPos;
            float twinkle = sin(uTime * 0.4 + position.x * 0.08 + position.y * 0.12) * 0.3 + 0.7;
            vAlpha = twinkle * (0.08 + size * 0.06);
          }
        `,
        fragmentShader: `
          uniform vec3 uColor;
          varying float vAlpha;
          void main() {
            float d = length(gl_PointCoord - vec2(0.5));
            if (d > 0.5) discard;
            float glow = 1.0 - smoothstep(0.0, 0.5, d);
            gl_FragColor = vec4(uColor, vAlpha * glow);
          }
        `,
      });

      const stars = new THREE.Points(starGeo, starMat);
      scene.add(stars);

      // Crosshair markers (deep background)
      const crosshairGroup = new THREE.Group();
      for (let i = 0; i < 8; i++) {
        const x = (Math.random() - 0.5) * 120;
        const y = (Math.random() - 0.5) * 70;
        const z = -30 - Math.random() * 20;
        const sz = 1.0 + Math.random() * 1.2;

        const positions = new Float32Array([
          x - sz, y, z, x + sz, y, z,
          x, y - sz, z, x, y + sz, z,
        ]);
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        crosshairGroup.add(new THREE.LineSegments(geo, new THREE.LineBasicMaterial({ color: 0x4a90d9, transparent: true, opacity: 0.12 })));

        const bSz = sz * 0.4;
        const bOff = sz * 0.8;
        const bp = new Float32Array([
          x-bOff, y+bOff-bSz, z, x-bOff, y+bOff, z,  x-bOff, y+bOff, z, x-bOff+bSz, y+bOff, z,
          x+bOff, y+bOff-bSz, z, x+bOff, y+bOff, z,  x+bOff, y+bOff, z, x+bOff-bSz, y+bOff, z,
          x-bOff, y-bOff+bSz, z, x-bOff, y-bOff, z,  x-bOff, y-bOff, z, x-bOff+bSz, y-bOff, z,
          x+bOff, y-bOff+bSz, z, x+bOff, y-bOff, z,  x+bOff, y-bOff, z, x+bOff-bSz, y-bOff, z,
        ]);
        const bGeo = new THREE.BufferGeometry();
        bGeo.setAttribute('position', new THREE.Float32BufferAttribute(bp, 3));
        crosshairGroup.add(new THREE.LineSegments(bGeo, new THREE.LineBasicMaterial({ color: 0x4a90d9, transparent: true, opacity: 0.07 })));
      }
      scene.add(crosshairGroup);

      // ═══════════════════════════════════════════════════════════
      // LAYER 2: NETWORK NODES — 5 SCROLL STAGES, GLOW SPRITES
      // ═══════════════════════════════════════════════════════════
      const networkGroup = new THREE.Group();

      interface NodeData {
        stages: THREE.Vector3[]; // [topology, clusters, pipeline, hub, constellation]
        currentPos: THREE.Vector3;
        repel: THREE.Vector3;      // cursor-repulsion offset (springy)
        wave: number;              // per-node stagger offset for morph sweeps
        size: number;              // sprite base scale
        isHub: boolean;
        sprite: THREE.Sprite;
      }

      const nodes: NodeData[] = [];
      const hubCount = 8;
      const satelliteCount = isMobile ? 56 : 112;
      const totalNodes = hubCount + satelliteCount;
      const spread = 14;

      // Stage 1: three clusters — the three service pillars
      const clusterCenters = [
        new THREE.Vector3(-8, 2.5, 0),   // UniFi
        new THREE.Vector3(8, 2.5, 0),    // AI Automation
        new THREE.Vector3(0, -4.5, 0),   // Software & App Development
      ];

      // Stage 2: pipeline — a flowing horizontal line (the 4-step process)
      function pipelinePos(t: number, jitterY: number, jitterZ: number): THREE.Vector3 {
        const x = -15 + t * 30;
        return new THREE.Vector3(x, Math.sin(x * 0.35) * 2.2 + jitterY, jitterZ);
      }

      // Stage 3: single hub — everything converges to one point (the About story)
      function hubPos(radius: number): THREE.Vector3 {
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        return new THREE.Vector3(
          radius * Math.sin(phi) * Math.cos(theta),
          radius * Math.sin(phi) * Math.sin(theta),
          radius * Math.cos(phi)
        );
      }

      // Stage 4: wide constellation scatter
      function scatterPos(): THREE.Vector3 {
        const angle = Math.random() * Math.PI * 2;
        const r = 10 + Math.random() * 20;
        return new THREE.Vector3(
          Math.cos(angle) * r,
          Math.sin(angle) * r * 0.6,
          (Math.random() - 0.5) * 14
        );
      }

      function makeSprite(tex: THREE.CanvasTexture, size: number, opacity: number): THREE.Sprite {
        const mat = new THREE.SpriteMaterial({
          map: tex,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          transparent: true,
          opacity,
        });
        const sp = new THREE.Sprite(mat);
        sp.scale.setScalar(size);
        return sp;
      }

      // Hubs — ring of 8 in stage 0, waypoints in later stages
      for (let i = 0; i < hubCount; i++) {
        const angle = (i / hubCount) * Math.PI * 2;
        const radius = 3 + Math.random() * (spread * 0.5);
        const topology = new THREE.Vector3(
          Math.cos(angle) * radius + (Math.random() - 0.5) * 3,
          Math.sin(angle) * radius + (Math.random() - 0.5) * 3,
          (Math.random() - 0.5) * 6
        );
        const cluster = clusterCenters[i % 3];
        const clusters = new THREE.Vector3(
          cluster.x + (Math.random() - 0.5) * 1.5,
          cluster.y + (Math.random() - 0.5) * 3,
          (Math.random() - 0.5) * 2
        );
        // Hubs sit exactly on the pipeline curve at even intervals
        const pipeline = pipelinePos(i / (hubCount - 1), 0, 0);
        const hub = hubPos(1.1);
        const constellation = scatterPos();

        const size = 1.5 + Math.random() * 0.5;
        const sprite = makeSprite(amberGlow, size, 0.95);
        sprite.position.copy(topology);
        networkGroup.add(sprite);
        nodes.push({
          stages: [topology, clusters, pipeline, hub, constellation],
          currentPos: topology.clone(),
          repel: new THREE.Vector3(),
          wave: Math.random(),
          size,
          isHub: true,
          sprite,
        });
      }

      // Satellites — loose field in stage 0, followers in later stages
      for (let i = 0; i < satelliteCount; i++) {
        const topology = new THREE.Vector3(
          (Math.random() - 0.5) * spread * 2,
          (Math.random() - 0.5) * spread * 1.5,
          (Math.random() - 0.5) * 8
        );
        const cluster = clusterCenters[i % 3];
        const clusters = new THREE.Vector3(
          cluster.x + (Math.random() - 0.5) * 5,
          cluster.y + (Math.random() - 0.5) * 6,
          (Math.random() - 0.5) * 3
        );
        const pipeline = pipelinePos(
          Math.random(),
          (Math.random() - 0.5) * 1.6,
          (Math.random() - 0.5) * 2.5
        );
        const hub = hubPos(1.8 + Math.random() * 1.2);
        const constellation = scatterPos();

        // Depth variance: nearer nodes bigger & brighter
        const size = 0.45 + Math.random() * 0.6;
        const sprite = makeSprite(blueGlow, size, 0.5 + Math.random() * 0.35);
        sprite.position.copy(topology);
        networkGroup.add(sprite);
        nodes.push({
          stages: [topology, clusters, pipeline, hub, constellation],
          currentPos: topology.clone(),
          repel: new THREE.Vector3(),
          wave: Math.random(),
          size,
          isHub: false,
          sprite,
        });
      }

      // Connection pairs — store indices for dynamic updates
      const connectionThreshold = 3.8;
      interface ConnectionPair { i: number; j: number; }
      const connectionPairs: ConnectionPair[] = [];

      for (let i = 0; i < totalNodes; i++) {
        for (let j = i + 1; j < totalNodes; j++) {
          const d = nodes[i].stages[0].distanceTo(nodes[j].stages[0]);
          if (d < connectionThreshold) {
            connectionPairs.push({ i, j });
          }
        }
      }

      const connectionArray = new Float32Array(connectionPairs.length * 6);
      connectionPairs.forEach((pair, idx) => {
        const n1 = nodes[pair.i];
        const n2 = nodes[pair.j];
        connectionArray[idx * 6] = n1.currentPos.x;
        connectionArray[idx * 6 + 1] = n1.currentPos.y;
        connectionArray[idx * 6 + 2] = n1.currentPos.z;
        connectionArray[idx * 6 + 3] = n2.currentPos.x;
        connectionArray[idx * 6 + 4] = n2.currentPos.y;
        connectionArray[idx * 6 + 5] = n2.currentPos.z;
      });

      const connectionGeo = new THREE.BufferGeometry();
      connectionGeo.setAttribute('position', new THREE.Float32BufferAttribute(connectionArray, 3));
      const connectionMat = new THREE.LineBasicMaterial({ color: 0x3b82f6, transparent: true, opacity: 0.12 });
      const connections = new THREE.LineSegments(connectionGeo, connectionMat);
      networkGroup.add(connections);

      // Data pulses — amber glow sprites traveling between random nodes
      interface PulseData {
        sprite: THREE.Sprite;
        fromIdx: number;
        toIdx: number;
        progress: number;
        speed: number;
      }

      const pulses: PulseData[] = [];
      const pulseCount = isMobile ? 14 : 35;

      function getRandomPairIdx(): [number, number] {
        const a = Math.floor(Math.random() * totalNodes);
        let b = a;
        let tries = 0;
        while (b === a && tries < 20) {
          b = Math.floor(Math.random() * totalNodes);
          tries++;
        }
        return [a, b];
      }

      for (let i = 0; i < pulseCount; i++) {
        const [fromIdx, toIdx] = getRandomPairIdx();
        const sprite = makeSprite(amberGlow, 0.55, 0.9);
        sprite.position.copy(nodes[fromIdx].currentPos);
        networkGroup.add(sprite);
        pulses.push({ sprite, fromIdx, toIdx, progress: Math.random(), speed: 0.003 + Math.random() * 0.006 });
      }

      scene.add(networkGroup);

      // ═══════════════════════════════════════════════════════════
      // INTERACTION & ANIMATION
      // ═══════════════════════════════════════════════════════════
      let mouseX = 0, mouseY = 0;
      const mouseWorld = new THREE.Vector3(9999, 9999, 0);
      const unprojVec = new THREE.Vector3();

      document.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
        mouseY = (e.clientY / window.innerHeight - 0.5) * 2;

        // Project cursor onto the z=0 plane for node repulsion
        unprojVec.set(mouseX, -mouseY, 0.5).unproject(camera);
        const dir = unprojVec.sub(camera.position).normalize();
        const t = -camera.position.z / dir.z;
        if (t > 0) mouseWorld.copy(camera.position).add(dir.multiplyScalar(t));
      }, { passive: true });

      // Theme-aware colors
      function updateColors() {
        const isDark = document.documentElement.classList.contains('dark');
        starMat.uniforms.uColor.value.set(isDark ? 0x6ba3d6 : 0x3b6fa5);
        connectionMat.color.set(isDark ? 0x60a5fa : 0x2563eb);
        connectionMat.opacity = isDark ? 0.12 : 0.08;
      }

      const themeObs = new MutationObserver(updateColors);
      themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      updateColors();

      let time = 0;
      let introT = 0;          // cinematic dolly-in
      let smoothStage = 0;     // smoothed stage float
      const LAST_STAGE = 4;
      const WAVE = 0.45;       // morph sweep window (per-node stagger)

      // Small overshoot for settle feel
      const easeOutBack = (t: number) => {
        const c = 1.35;
        return 1 + (c + 1) * Math.pow(t - 1, 3) + c * Math.pow(t - 1, 2);
      };

      const tmpPos = new THREE.Vector3();

      function animate() {
        requestAnimationFrame(animate);
        time += 0.016;

        // Cinematic intro: dolly 30→18, group settles 1.15→1
        if (introT < 1) introT = Math.min(1, introT + 0.011);
        const intro = easeOutExpo(introT);
        networkGroup.scale.setScalar(1.15 - 0.15 * intro);

        smoothStage += (stageTarget - smoothStage) * 0.08;
        const s = Math.max(0, Math.min(LAST_STAGE, smoothStage));

        starMat.uniforms.uTime.value = time;

        // Mouse parallax — camera drifts toward cursor
        const tX = mouseY * 1.5;
        const tY = mouseX * 2;
        camera.position.x += (tY - camera.position.x) * 0.02;
        camera.position.y += (-tX - camera.position.y) * 0.02;
        // Camera: intro dolly + gentle pull-back through the story
        const scrollZoom = 18 + s * 1.6 + (1 - intro) * 12;
        camera.position.z += (scrollZoom - camera.position.z) * 0.05;
        camera.lookAt(0, 0, 0);

        // Auto-rotation slows as the story settles into layouts
        const rotSpeed = (1 - Math.min(1, s / LAST_STAGE) * 0.8) * intro;
        networkGroup.rotation.y += 0.001 * rotSpeed;
        networkGroup.rotation.x += 0.0003 * rotSpeed;
        networkGroup.rotation.y += mouseX * 0.0005 * rotSpeed;
        networkGroup.rotation.x += mouseY * 0.0003 * rotSpeed;
        // Ease group rotation back toward zero so later stages read clean
        networkGroup.rotation.x *= 0.995;
        networkGroup.rotation.z *= 0.995;

        // Starfield slow drift
        stars.rotation.z += 0.00004;
        crosshairGroup.rotation.z -= 0.00002;

        // Repulsion active in the early stages (hero + chapter toy)
        const repelActive = s < 1.5 && !isTouch;

        // ── MORPH NODE POSITIONS with wave-staggered sweep ──
        // Stagger only exists mid-transition: at stage holds the lag collapses
        // to zero so every layout settles crisp before the next sweep begins.
        const stageFrac = s - Math.floor(Math.min(s, LAST_STAGE - 1e-9));
        const waveLag = WAVE * 4 * stageFrac * (1 - stageFrac);
        for (const node of nodes) {
          const ls = Math.max(0, Math.min(LAST_STAGE, s - node.wave * waveLag));
          const idx = Math.min(Math.floor(ls), LAST_STAGE - 1);
          const frac = easeOutBack(ls - idx);
          node.currentPos.lerpVectors(node.stages[idx], node.stages[idx + 1], frac);

          // Cursor repulsion (springy offset)
          if (repelActive) {
            tmpPos.copy(node.currentPos).sub(mouseWorld);
            tmpPos.z = 0;
            const d = tmpPos.length();
            if (d < 3 && d > 0.001) {
              const push = ((3 - d) / 3) * 1.4;
              tmpPos.normalize().multiplyScalar(push);
              node.repel.lerp(tmpPos, 0.12);
            } else {
              node.repel.multiplyScalar(0.9);
            }
          } else {
            node.repel.multiplyScalar(0.9);
          }

          node.sprite.position.copy(node.currentPos).add(node.repel);
        }

        // ── UPDATE CONNECTIONS dynamically ──
        const connPos = connectionGeo.getAttribute('position') as THREE.BufferAttribute;
        const connArr = connPos.array as Float32Array;
        for (let idx = 0; idx < connectionPairs.length; idx++) {
          const pair = connectionPairs[idx];
          const n1 = nodes[pair.i];
          const n2 = nodes[pair.j];
          connArr[idx * 6] = n1.sprite.position.x;
          connArr[idx * 6 + 1] = n1.sprite.position.y;
          connArr[idx * 6 + 2] = n1.sprite.position.z;
          connArr[idx * 6 + 3] = n2.sprite.position.x;
          connArr[idx * 6 + 4] = n2.sprite.position.y;
          connArr[idx * 6 + 5] = n2.sprite.position.z;
        }
        connPos.needsUpdate = true;

        // Connections glow a little stronger around the pipeline stage
        const connBaseOpacity = document.documentElement.classList.contains('dark') ? 0.12 : 0.08;
        const pipelineEmphasis = Math.exp(-Math.pow(s - 2, 2) / 0.5) * 0.5;
        connectionMat.opacity = connBaseOpacity * (0.75 + pipelineEmphasis) * intro;

        // Animate data pulses — follow current (morphed) positions
        for (const pulse of pulses) {
          pulse.progress += pulse.speed;
          if (pulse.progress >= 1) {
            pulse.progress = 0;
            const [a, b] = getRandomPairIdx();
            pulse.fromIdx = a;
            pulse.toIdx = b;
          }
          const t = pulse.progress;
          const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          pulse.sprite.position.lerpVectors(nodes[pulse.fromIdx].sprite.position, nodes[pulse.toIdx].sprite.position, ease);
          const fade = Math.sin(t * Math.PI);
          (pulse.sprite.material as THREE.SpriteMaterial).opacity = fade * 0.9 * intro;
        }

        // Hub breathing — swells as the story converges to the single hub
        const hubSwell = 1 + Math.exp(-Math.pow(s - 3, 2) / 0.35) * 0.6;
        const breathe = (Math.sin(time * 1.5) * 0.12 + 1) * hubSwell * (0.6 + 0.4 * intro);
        for (const node of nodes) {
          if (node.isHub) node.sprite.scale.setScalar(node.size * breathe);
        }

        renderer.render(scene, camera);
      }

      animate();
    } catch {
      // WebGL unavailable — remove the canvas and let the plain background stand
      canvas.remove();
    }
  } else if (canvas) {
    // Reduced motion — no animated background at all
    canvas.remove();
  }

  // ─── HERO WORD SWAP (blur-flip loop) ───
  const heroWord = document.getElementById('hero-word') as HTMLElement | null;
  if (heroWord && !reducedMotion) {
    const words = ['thinks', 'scales', 'adapts', 'evolves'];
    let idx = 0;
    // Explicit from→to pairs keep every loop identical regardless of the inline
    // styles left behind by the previous pass.
    createTimeline({ loop: true, defaults: { duration: 340, ease: 'inOutQuad' } })
      .add(heroWord, {
        opacity: [1, 0],
        translateY: [0, -10],
        filter: ['blur(0px)', 'blur(6px)'],
        onComplete: () => {
          idx = (idx + 1) % words.length;
          heroWord.textContent = words[idx];
        },
      }, 2500)
      .add(heroWord, {
        opacity: [0, 1],
        translateY: [10, 0],
        filter: ['blur(6px)', 'blur(0px)'],
      });
  }

  // ─── CONTACT FORM ───
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const successEl = document.getElementById('cf-success') as HTMLElement | null;
  const errorEl = document.getElementById('cf-error') as HTMLElement | null;

  // Unhide a form notice and ease it in (reduced motion just unhides it).
  function showNotice(el: HTMLElement) {
    el.hidden = false;
    if (reducedMotion) return;
    animate(el, { opacity: [0, 1], translateY: [12, 0], duration: 600, ease: 'outExpo' });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !successEl || !errorEl) return;

    submitBtn.classList.add('loading');
    submitBtn.disabled = true;
    successEl.hidden = true;
    errorEl.hidden = true;

    try {
      const data = new FormData(form);
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        showNotice(successEl);
        successEl.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'nearest' });
      } else {
        showNotice(errorEl);
      }
    } catch {
      showNotice(errorEl);
    } finally {
      submitBtn.classList.remove('loading');
      submitBtn.disabled = false;
    }
  });
</script>
